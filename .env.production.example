# Production environment config for docker-compose.prod.yml
# Copy this to a file literally named ".env" in the project root on the server
# (docker compose auto-loads ".env"). Never commit the real file.
#
# Generate strong random values, e.g.:
#   openssl rand -base64 32

MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=keelworks_keelcompass_db
JWT_SECRET=changeme

# Signup restriction: only emails on this domain may register
ALLOWED_SIGNUP_DOMAIN=keelworks.org

# SMTP config for sending verification emails.
# If SMTP_HOST is left blank, codes are written to the backend container's
# logs instead of being emailed (docker compose logs -f backend), so the
# app degrades safely if this isn't filled in yet.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16charapppassword
SMTP_FROM="KeelCompass <youraddress@gmail.com>"
