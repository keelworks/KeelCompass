# Production environment config for docker-compose.prod.yml
# Copy this to a file literally named ".env" in the project root on the server
# (docker compose auto-loads ".env"). Never commit the real file.
#
# Generate strong random values, e.g.:
#   openssl rand -base64 32

MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=keelworks_keelcompass_db
JWT_SECRET=changeme

# Sign-in restriction: only Google Workspace accounts on this domain may sign in
ALLOWED_SIGNUP_DOMAIN=keelworks.org

# Google OAuth 2.0 Client ID (Web application type) used to verify Google
# Sign-In ID tokens. Create one in Google Cloud Console for the KeelWorks
# Workspace; no client secret is needed for this flow. The frontend needs
# the same value baked in at build time as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# First sign-in with this email is auto-granted the admin role, so there's
# always at least one admin able to manage role-tag mappings.
BOOTSTRAP_ADMIN_EMAIL=
