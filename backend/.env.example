PORT=8080

# DB configuration for development environment
DB_HOST=localhost       # Replace with your MySQL host, e.g., localhost or your DB IP
DB_USER=root            # Replace with your MySQL username
DB_PASS=yourpassword    # Replace with your MySQL password
DB_DATABASE=yourdbname  # Replace with your MySQL database name
DB_DIALECT=mysql

# Logging configuration
LOG_PATH=logs/app.log

# Authentication
JWT_SECRET=yoursecret

# Signup restriction: only emails on this domain may register
ALLOWED_SIGNUP_DOMAIN=keelworks.org

# SMTP configuration for sending verification emails.
# If SMTP_HOST is left unset, verification codes are written to the
# server log instead of being emailed, which is convenient for local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KeelCompass <no-reply@keelworks.org>"
