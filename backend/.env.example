PORT=8080

# DB configuration for development environment
DB_HOST=localhost       # Replace with your MySQL host, e.g., localhost or your DB IP
DB_USER=root            # Replace with your MySQL username
DB_PASS=yourpassword    # Replace with your MySQL password
DB_DATABASE=yourdbname  # Replace with your MySQL database name
DB_DIALECT=mysql

# Logging configuration
LOG_PATH=logs/app.log

# Authentication
JWT_SECRET=yoursecret

# Sign-in restriction: only Google Workspace accounts on this domain may sign in
ALLOWED_SIGNUP_DOMAIN=keelworks.org

# Google OAuth 2.0 Client ID (Web application type) used to verify Google
# Sign-In ID tokens. Create one in Google Cloud Console for the KeelWorks
# Workspace; no client secret is needed for this flow.
GOOGLE_CLIENT_ID=

# First sign-in with this email is auto-granted the admin role, so there's
# always at least one admin able to manage role-tag mappings.
BOOTSTRAP_ADMIN_EMAIL=
